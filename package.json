{
  "name": "bifang-telemetry-update-infrastructure",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Daily-active telemetry and client update center integration for Bifang desktop tools.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "cloudbase/functions/*"
  ],
  "scripts": {
    "cloudbase:app:add": "node cloudbase/add-app.mjs",
    "cloudbase:app:stream:add": "node cloudbase/add-release-stream.mjs",
    "cloudbase:app:deploy:plan": "node cloudbase/plan-app-deployment.mjs",
    "cloudbase:version-api:deploy:plan": "node cloudbase/plan-application-version-api-deployment.mjs",
    "cloudbase:dashboard:deploy:plan": "node cloudbase/deploy-operations-dashboard.mjs plan",
    "cloudbase:dashboard:deploy": "node cloudbase/deploy-operations-dashboard.mjs deploy",
    "cloudbase:dashboard:code:plan": "node cloudbase/deploy-operations-dashboard-code.mjs plan",
    "cloudbase:dashboard:code:deploy": "node cloudbase/deploy-operations-dashboard-code.mjs deploy",
    "cloudbase:dashboard:verify": "node cloudbase/verify-operations-dashboard.mjs",
    "cloudbase:config": "node cloudbase/generate-cloudbaserc.mjs",
    "cloudbase:config:check": "node cloudbase/generate-cloudbaserc.mjs --check",
    "cloudbase:labels:check": "node cloudbase/app-labels.mjs check",
    "cloudbase:app:name": "node cloudbase/app-labels.mjs set",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:examples": "npm run build --workspace @bifang/telemetry-update-sdk && tsc -p examples/tsconfig.json --noEmit",
    "test": "npm run test:workspaces && node --test tests/*.test.mjs && npm run test:python-client",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test:python-client": "python -m unittest discover -s tools/python-sdk-test-client/tests -p \"test_*.py\" -v",
    "format": "prettier --write \"**/*.{ts,js,mjs,cjs,json,md}\" --ignore-unknown",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,cjs,json,md}\" --ignore-unknown",
    "check": "npm run cloudbase:config:check && npm run cloudbase:labels:check && npm run format:check && npm run typecheck && npm test && npm run build && npm run typecheck:examples"
  },
  "devDependencies": {
    "@cloudbase/cli": "3.8.1",
    "@types/node": "^20.19.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
