# Copy to .env only for a local CloudBase deployment workflow.
# Per-app ALLOWED_APP_IDS, TELEMETRY_COLLECTION, and TRACK_PATH values are
# generated from cloudbase/apps.json; do not maintain a global allowlist here.
ENV_ID=replace-with-cloudbase-env-id

# The dashboard function receives only this SHA-256 value. Keep the original
# high-entropy bearer token outside the repository and configure it in Sites.
DASHBOARD_TOKEN_SHA256=replace-with-64-lowercase-hex-characters
