{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "version": "2.1",
  "envId": "{{env.ENV_ID}}",
  "functionRoot": "./cloudbase/functions",
  "functions": [
    {
      "name": "telemetry-bifang-tools",
      "dir": "./cloudbase/functions/telemetry",
      "type": "Event",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 3,
      "memorySize": 256,
      "installDependency": true,
      "envVariables": {
        "ALLOWED_APP_IDS": "bifang-tools",
        "TELEMETRY_COLLECTION": "telemetry_bifang_tools",
        "TRACK_PATH": "/apps/bifang-tools/v1/track"
      }
    }
  ],
  "hosting": [
    {
      "name": "updates",
      "root": "./cloudbase/updates",
      "framework": "static",
      "installCommand": "",
      "buildCommand": "",
      "outputDir": ".",
      "deployPath": "/updates"
    }
  ],
  "gateway": {
    "routes": [
      {
        "path": "/apps/bifang-tools/v1/track",
        "target": "function:telemetry-bifang-tools",
        "protocol": "HTTP_TO_HTTPS",
        "enablePathTransmission": true,
        "enableAuth": false,
        "qpsPolicy": {
          "qpsTotal": 100,
          "qpsPerClient": {
            "limitBy": "ClientIP",
            "limitValue": 10
          }
        }
      },
      {
        "path": "/updates",
        "target": "hosting:updates",
        "enableAuth": false
      }
    ]
  }
}
