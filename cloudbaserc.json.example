{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "version": "2.1",
  "envId": "{{env.ENV_ID}}",
  "functionRoot": "./cloudbase/functions",
  "functions": [
    {
      "name": "telemetry-bifang-screen-recorder",
      "dir": "./cloudbase/functions/telemetry",
      "type": "Event",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 3,
      "memorySize": 256,
      "installDependency": true,
      "envVariables": {
        "ALLOWED_APP_IDS": "bifang-screen-recorder",
        "TELEMETRY_COLLECTION": "telemetry_bifang_screen_recorder",
        "TRACK_PATH": "/apps/bifang-screen-recorder/v1/track"
      }
    },
    {
      "name": "telemetry-bifang-mouse-clicker",
      "dir": "./cloudbase/functions/telemetry",
      "type": "Event",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 3,
      "memorySize": 256,
      "installDependency": true,
      "envVariables": {
        "ALLOWED_APP_IDS": "bifang-mouse-clicker",
        "TELEMETRY_COLLECTION": "telemetry_bifang_mouse_clicker",
        "TRACK_PATH": "/apps/bifang-mouse-clicker/v1/track"
      }
    },
    {
      "name": "operations-dashboard-api",
      "dir": "./cloudbase/functions/operations-dashboard",
      "type": "Event",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 8,
      "memorySize": 256,
      "installDependency": true,
      "envVariables": {
        "CLOUDBASE_ENV_ID": "{{env.ENV_ID}}",
        "DASHBOARD_APPS_JSON": "\"[{\\\"appId\\\":\\\"bifang-screen-recorder\\\",\\\"collectionName\\\":\\\"telemetry_bifang_screen_recorder\\\",\\\"platforms\\\":[\\\"windows\\\",\\\"macos\\\"]},{\\\"appId\\\":\\\"bifang-mouse-clicker\\\",\\\"collectionName\\\":\\\"telemetry_bifang_mouse_clicker\\\",\\\"platforms\\\":[\\\"windows\\\"]}]\"",
        "DASHBOARD_PATH": "/admin/v1/metrics",
        "DASHBOARD_TOKEN_SHA256": "{{env.DASHBOARD_TOKEN_SHA256}}",
        "DASHBOARD_UPDATES_BASE_URL": "{{env.DASHBOARD_UPDATES_BASE_URL}}"
      }
    }
  ],
  "hosting": [
    {
      "name": "updates",
      "root": "./cloudbase/updates",
      "framework": "static",
      "installCommand": "",
      "buildCommand": "",
      "outputDir": ".",
      "deployPath": "/updates"
    }
  ],
  "gateway": {
    "routes": [
      {
        "path": "/apps/bifang-screen-recorder/v1/track",
        "target": "function:telemetry-bifang-screen-recorder",
        "protocol": "HTTP_TO_HTTPS",
        "enablePathTransmission": true,
        "enableAuth": false,
        "qpsPolicy": {
          "qpsTotal": 100,
          "qpsPerClient": {
            "limitBy": "ClientIP",
            "limitValue": 10
          }
        }
      },
      {
        "path": "/apps/bifang-mouse-clicker/v1/track",
        "target": "function:telemetry-bifang-mouse-clicker",
        "protocol": "HTTP_TO_HTTPS",
        "enablePathTransmission": true,
        "enableAuth": false,
        "qpsPolicy": {
          "qpsTotal": 100,
          "qpsPerClient": {
            "limitBy": "ClientIP",
            "limitValue": 10
          }
        }
      },
      {
        "path": "/admin/v1/metrics",
        "target": "function:operations-dashboard-api",
        "protocol": "HTTP_TO_HTTPS",
        "enablePathTransmission": true,
        "enableAuth": false,
        "qpsPolicy": {
          "qpsTotal": 5,
          "qpsPerClient": {
            "limitBy": "ClientIP",
            "limitValue": 2
          }
        }
      },
      {
        "path": "/updates",
        "target": "hosting:updates",
        "enableAuth": false
      }
    ]
  }
}
