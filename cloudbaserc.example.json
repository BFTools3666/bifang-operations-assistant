ndows\\\",\\\"architecture\\\":\\\"x64\\\",\\\"channel\\\":\\\"stable\\\",\\\"code\\\":\\\"bifang-app-launcher-windows-x64\\\"},{\\\"platform\\\":\\\"macos\\\",\\\"architecture\\\":\\\"x64\\\",\\\"channel\\\":\\\"stable\\\",\\\"code\\\":\\\"bifang-app-launcher-macos-x64\\\"},{\\\"platform\\\":\\\"macos\\\",\\\"architecture\\\":\\\"arm64\\\",\\\"channel\\\":\\\"stable\\\",\\\"code\\\":\\\"bifang-app-launcher-macos-arm64\\\"}]}]\"",
