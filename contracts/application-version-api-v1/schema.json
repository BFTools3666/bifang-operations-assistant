{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example.invalid/bifang/application-version-api/v1/schema.json",
  "title": "Bifang application version API v1 schema catalog",
  "description": "External contract implemented and tested locally. It is not evidence of CloudBase deployment or original-client E2E.",
  "$defs": {
    "ApplicationCodePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^(?!\\.{1,2}$)[^\\s\\\\/?#\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u180e\\u200b\\u200e\\u200f\\u2028-\\u202e\\u2060-\\u206f\\ufeff\\ufff9-\\ufffb]+$",
      "description": "Case-sensitive application code after URL decoding; dot path segments and backslashes are forbidden."
    },
    "ApplicationCodeWrite": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "pattern": "^(?!\\.{1,2}$)[^\\s\\\\/?#\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u180e\\u200b\\u200e\\u200f\\u2028-\\u202e\\u2060-\\u206f\\ufeff\\ufff9-\\ufffb]+$"
    },
    "VersionNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "pattern": "^[0-9]+(?:\\.[0-9]+)*$",
      "description": "Numeric dotted version; absent trailing segments compare as zero."
    },
    "VersionId": {
      "type": "string",
      "pattern": "^[0-9]{19}$",
      "description": "The source contract requires a 19-digit version identifier; keep it as a JSON string."
    },
    "AdId": {
      "type": "string",
      "pattern": "^[0-9]{1,19}$",
      "description": "Advertisement identifier kept as a JSON string to avoid precision loss."
    },
    "UpdateOperator": {
      "type": "string",
      "enum": ["ge", "gt", "le", "lt"]
    },
    "HttpsUrl500": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://(?![^/?#]*@)[^\\s]+$",
      "description": "HTTPS URL without user info whose host passes the service's explicit local and special-use address exclusions. DNS rebinding and application-specific host authorization require a deployment allowlist."
    },
    "Text100": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^<>\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u180e\\u200b\\u200e\\u200f\\u2028-\\u202e\\u2060-\\u206f\\ufeff\\ufff9-\\ufffb]+$",
      "description": "Plain display text; markup and invisible control or bidirectional formatting characters are rejected."
    },
    "Text50": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "pattern": "^[^<>\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u180e\\u200b\\u200e\\u200f\\u2028-\\u202e\\u2060-\\u206f\\ufeff\\ufff9-\\ufffb]+$",
      "description": "Plain display text; markup and invisible control or bidirectional formatting characters are rejected."
    },
    "UpdateContent": {
      "type": "string",
      "maxLength": 10000,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u180e\\u200b\\u200e\\u200f\\u2028-\\u202e\\u2060-\\u206f\\ufeff\\ufff9-\\ufffb]*$",
      "description": "The source document gives no field limit. Bound the complete HTTP body and sanitize this compatibility string with an allowlist before storage or output."
    },
    "VersionWriteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "code",
        "codeVersion",
        "downloadUrl",
        "promptContent",
        "forcedUpdate",
        "promptUpdate",
        "stopUpdate"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/Text50" },
        "code": { "$ref": "#/$defs/ApplicationCodeWrite" },
        "codeVersion": { "$ref": "#/$defs/VersionNumber" },
        "downloadUrl": { "$ref": "#/$defs/HttpsUrl500" },
        "promptContent": { "$ref": "#/$defs/Text100" },
        "forcedUpdate": { "type": "boolean" },
        "promptUpdate": { "type": "boolean" },
        "stopUpdate": { "type": "boolean" },
        "updateContent": { "$ref": "#/$defs/UpdateContent" },
        "updateCriteria": { "$ref": "#/$defs/UpdateOperator" },
        "versionCriteria": { "$ref": "#/$defs/VersionNumber" }
      },
      "dependentRequired": {
        "updateCriteria": ["versionCriteria"],
        "versionCriteria": ["updateCriteria"]
      },
      "oneOf": [
        {
          "properties": {
            "forcedUpdate": { "const": false },
            "promptUpdate": { "const": false },
            "stopUpdate": { "const": false }
          }
        },
        {
          "properties": {
            "forcedUpdate": { "const": true },
            "promptUpdate": { "const": false },
            "stopUpdate": { "const": false }
          }
        },
        {
          "properties": {
            "forcedUpdate": { "const": false },
            "promptUpdate": { "const": true },
            "stopUpdate": { "const": false }
          }
        },
        {
          "properties": {
            "forcedUpdate": { "const": false },
            "promptUpdate": { "const": false },
            "stopUpdate": { "const": true }
          }
        }
      ]
    },
    "VersionListRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "code",
        "codeVersion",
        "downloadUrl",
        "promptContent",
        "forcedUpdate",
        "promptUpdate",
        "stopUpdate",
        "updateContent"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/VersionId" },
        "name": { "$ref": "#/$defs/Text50" },
        "code": { "$ref": "#/$defs/ApplicationCodeWrite" },
        "codeVersion": { "$ref": "#/$defs/VersionNumber" },
        "downloadUrl": { "$ref": "#/$defs/HttpsUrl500" },
        "promptContent": { "$ref": "#/$defs/Text100" },
        "forcedUpdate": { "type": "boolean" },
        "promptUpdate": { "type": "boolean" },
        "stopUpdate": { "type": "boolean" },
        "updateContent": { "$ref": "#/$defs/UpdateContent" },
        "updateCriteria": { "$ref": "#/$defs/UpdateOperator" },
        "versionCriteria": { "$ref": "#/$defs/VersionNumber" }
      },
      "dependentRequired": {
        "updateCriteria": ["versionCriteria"],
        "versionCriteria": ["updateCriteria"]
      }
    },
    "VersionCheckResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "update",
        "downloadUrl",
        "promptContent",
        "forcedUpdate",
        "promptUpdate",
        "stopUpdate",
        "updateContent"
      ],
      "properties": {
        "update": { "type": "boolean" },
        "downloadUrl": { "$ref": "#/$defs/HttpsUrl500" },
        "promptContent": { "$ref": "#/$defs/Text100" },
        "forcedUpdate": { "type": "boolean" },
        "promptUpdate": { "type": "boolean" },
        "stopUpdate": { "type": "boolean" },
        "updateContent": { "$ref": "#/$defs/UpdateContent" }
      }
    },
    "AdTitle": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[^<>\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u180e\\u200b\\u200e\\u200f\\u2028-\\u202e\\u2060-\\u206f\\ufeff\\ufff9-\\ufffb]*$",
      "description": "Plain display text; markup and invisible control or bidirectional formatting characters are rejected."
    },
    "AdUrl": {
      "maxLength": 255,
      "oneOf": [
        { "const": "" },
        {
          "type": "string",
          "minLength": 1,
          "format": "uri",
          "pattern": "^[Hh][Tt][Tt][Pp][Ss]://(?![^/?#]*@)[^\\s]+$"
        }
      ],
      "description": "Empty for source compatibility, otherwise the same validated HTTPS policy as downloads."
    },
    "AdImage": {
      "maxLength": 255,
      "oneOf": [
        { "const": "" },
        {
          "type": "string",
          "minLength": 1,
          "format": "uri",
          "pattern": "^[Hh][Tt][Tt][Pp][Ss]://(?![^/?#]*@)[^\\s]+$"
        }
      ],
      "description": "Empty means no image; otherwise the same validated HTTPS policy as downloads."
    },
    "AdContent": {
      "type": "string",
      "maxLength": 1000,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u180e\\u200b\\u200e\\u200f\\u2028-\\u202e\\u2060-\\u206f\\ufeff\\ufff9-\\ufffb]*$",
      "description": "Untrusted compatibility content; sanitize before storage or output."
    },
    "AdCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url"],
      "properties": {
        "title": { "$ref": "#/$defs/AdTitle" },
        "url": { "$ref": "#/$defs/AdUrl" },
        "image": { "$ref": "#/$defs/AdImage" },
        "content": { "$ref": "#/$defs/AdContent" }
      }
    },
    "AdUpdateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "content"],
      "properties": {
        "title": { "$ref": "#/$defs/AdTitle" },
        "url": { "$ref": "#/$defs/AdUrl" },
        "image": {
          "$ref": "#/$defs/AdImage",
          "description": "Provisional compatibility extension: omitted means keep the stored image."
        },
        "content": { "$ref": "#/$defs/AdContent" }
      }
    },
    "AdDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "appCode", "title", "url", "image", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/AdId" },
        "appCode": { "$ref": "#/$defs/ApplicationCodePath" },
        "title": { "$ref": "#/$defs/AdTitle" },
        "url": { "$ref": "#/$defs/AdUrl" },
        "image": { "$ref": "#/$defs/AdImage" },
        "content": { "$ref": "#/$defs/AdContent" }
      }
    },
    "AdListItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "appCode", "title", "url", "image"],
      "properties": {
        "id": { "$ref": "#/$defs/AdId" },
        "appCode": { "$ref": "#/$defs/ApplicationCodePath" },
        "title": { "$ref": "#/$defs/AdTitle" },
        "url": { "$ref": "#/$defs/AdUrl" },
        "image": { "$ref": "#/$defs/AdImage" }
      }
    },
    "AdShowItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "image", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/AdId" },
        "url": { "$ref": "#/$defs/AdUrl" },
        "image": { "$ref": "#/$defs/AdImage" },
        "content": { "$ref": "#/$defs/AdContent" }
      }
    },
    "AdShowResponse": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/AdShowItem" }
    },
    "PageMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "current", "total", "size"],
      "properties": {
        "model": { "const": "page" },
        "current": { "type": "integer", "minimum": 1 },
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total page count."
        },
        "size": { "type": "integer", "minimum": 1, "maximum": 100 },
        "total_page": {
          "type": "integer",
          "minimum": 0,
          "description": "Provisional compatibility alias for total; confirm with a real management client."
        }
      }
    },
    "VersionGridResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "result", "page"],
      "properties": {
        "model": { "const": "grid.result" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "datas", "total"],
          "properties": {
            "model": { "const": "data.set" },
            "datas": {
              "type": "array",
              "items": { "$ref": "#/$defs/VersionListRecord" }
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "description": "Total record count."
            }
          }
        },
        "page": { "$ref": "#/$defs/PageMetadata" }
      }
    },
    "AdGridResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "result", "page"],
      "properties": {
        "model": { "const": "grid.result" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "datas", "total"],
          "properties": {
            "model": { "const": "data.set" },
            "datas": {
              "type": "array",
              "items": { "$ref": "#/$defs/AdListItem" }
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "description": "Total record count."
            }
          }
        },
        "page": { "$ref": "#/$defs/PageMetadata" }
      }
    },
    "ErrorItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "code", "message"],
      "properties": {
        "model": { "const": "error" },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "ErrorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "errors"],
      "properties": {
        "model": { "const": "errors" },
        "errors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "datas"],
          "properties": {
            "model": { "const": "data.set" },
            "datas": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": { "$ref": "#/$defs/ErrorItem" }
            }
          }
        }
      }
    }
  }
}
