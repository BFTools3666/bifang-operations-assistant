{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bifang.local/schemas/public-services-profile.schema.json",
  "title": "Bifang public-services onboarding profile",
  "description": "A resumable, non-sensitive onboarding profile. Missing optional properties mean not yet confirmed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_schema_version"],
  "properties": {
    "profile_schema_version": {
      "const": 2,
      "description": "Profile v2 uses update_transport to distinguish historical application-version records from new client update center onboarding. Legacy v1 profiles require explicit migration."
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Confirmed Chinese product display name. The profile validator also requires a Han ideograph and rejects surrounding whitespace, control/format characters and markup. This is display metadata; app_id and release code remain technical identities."
    },
    "product_purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "product_key": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,41}[a-z0-9])?$",
      "maxLength": 43
    },
    "app_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,48}[a-z0-9])?$",
      "maxLength": 50
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": ["windows", "macos", "linux"]
      }
    },
    "architectures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": ["x64", "arm64", "ia32"]
      }
    },
    "framework": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "current_version": {
      "$ref": "#/$defs/semver"
    },
    "version_source": {
      "$ref": "#/$defs/projectFact"
    },
    "app_config_strategy": {
      "$ref": "#/$defs/projectFact"
    },
    "startup_entry": {
      "$ref": "#/$defs/projectFact"
    },
    "main_window_ready_hook": {
      "$ref": "#/$defs/projectFact"
    },
    "external_link_handler": {
      "$ref": "#/$defs/projectFact"
    },
    "exit_handler": {
      "$ref": "#/$defs/projectFact"
    },
    "cloudbase_env_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "cloudbase_origin": {
      "$ref": "#/$defs/cloudbaseGatewayUrl"
    },
    "telemetry_endpoint": {
      "$ref": "#/$defs/httpsUrl"
    },
    "update_transport": {
      "enum": ["application-version-api-v1", "client-update-center-v1"]
    },
    "update_center_base_url": {
      "enum": [
        "https://update.meetelf.com",
        "http://127.0.0.1:8080",
        "http://127.0.0.1:8080/"
      ]
    },
    "update_center_auth_status": {
      "enum": ["unknown", "planned", "ready", "verified"]
    },
    "offline_enforcement": {
      "enum": ["service-default", "persist-until-resolved"]
    },
    "update_targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/updateTarget" }
    },
    "application_version_contract_version": {
      "const": "1.0.0"
    },
    "application_version_base_url": {
      "$ref": "#/$defs/httpsUrl",
      "description": "Exact single-v1 endpoint on the CloudBase default origin or an operator-approved application-version gateway."
    },
    "release_streams": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/releaseStream"
      }
    },
    "version_api_auth_binding_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$",
      "description": "Non-sensitive server-side binding identifier only; never a key or secret value."
    },
    "version_api_auth_status": {
      "enum": ["unknown", "planned", "ready", "verified"]
    },
    "infrastructure_version": {
      "$ref": "#/$defs/semver"
    },
    "infrastructure_source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sdk_distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "version"],
      "properties": {
        "kind": {
          "enum": [
            "versioned_tarball",
            "private_package",
            "repository_copy",
            "workspace"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "verification_evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "immutable_reference": {
          "type": "string",
          "pattern": "^(?:sha256:[0-9a-f]{64}|git:[0-9a-f]{40})$"
        }
      }
    },
    "sdk_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "registration_status": {
      "enum": ["unknown", "not_registered", "registered", "verified"]
    },
    "legacy_track_status": {
      "enum": [
        "unknown",
        "not_found",
        "found",
        "migration_required",
        "retained"
      ]
    },
    "legacy_update_status": {
      "enum": ["detected", "not_found", "removed"],
      "description": "Removal state for the obsolete static /updates protocol. Version 2 never treats that protocol as a supported transport."
    },
    "deployment_gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_complete": {
          "type": "boolean"
        },
        "app_id_confirmed": {
          "type": "boolean"
        },
        "uses_existing_free_environment": {
          "type": "boolean"
        },
        "free_environment_confirmed": {
          "type": "boolean"
        },
        "app_registered": {
          "type": "boolean"
        },
        "app_display_name_registered": {
          "type": "boolean",
          "description": "Only true after the operator task verifies the registered APP_ID has exactly this display_name in the shared app-labels.json and runs the complete label coverage check."
        },
        "dashboard_display_name_verified": {
          "type": "boolean",
          "description": "Only true after authorized production verification finds this APP_ID and display_name in authenticated metrics and the rendered application filter and release-stream table. Local metadata alone does not prove deployment."
        },
        "cloudbase_config_reviewed": {
          "type": "boolean"
        },
        "platform_code_mapping_confirmed": {
          "type": "boolean"
        },
        "version_api_config_reviewed": {
          "type": "boolean"
        },
        "version_api_service_verified": {
          "type": "boolean"
        },
        "runtime_auth_ready": {
          "type": "boolean"
        },
        "function_deployed": {
          "type": "boolean"
        },
        "collection_created": {
          "type": "boolean"
        },
        "collection_admin_only": {
          "type": "boolean"
        },
        "route_deployed": {
          "type": "boolean"
        },
        "privacy_notice_ready": {
          "type": "boolean"
        },
        "online_e2e_passed": {
          "type": "boolean"
        },
        "client_integration_complete": {
          "type": "boolean"
        },
        "telemetry_app_version_verified": {
          "type": "boolean",
          "description": "Local host-level serialized daily_active requests were captured and their app_version matched the single application version source, including a changed test version on a new test day. Not merely SDK tests or a Profile snapshot."
        },
        "telemetry_app_version_online_verified": {
          "type": "boolean",
          "description": "Authorized real-client evidence binds the installed artifact version to an accepted telemetry app_version and the live dashboard version distribution. Never inferred from mocks or release records."
        },
        "version_api_client_integrated": {
          "type": "boolean"
        },
        "sdk_distribution_ready": {
          "type": "boolean"
        },
        "client_e2e_passed": {
          "type": "boolean"
        },
        "version_api_client_e2e_passed": {
          "type": "boolean"
        },
        "update_center_client_integrated": { "type": "boolean" },
        "update_center_service_verified": { "type": "boolean" },
        "update_center_client_e2e_passed": { "type": "boolean" },
        "legacy_client_update_removed": {
          "type": "boolean"
        },
        "legacy_cloud_resources_removed": {
          "type": "boolean"
        },
        "migration_observation_complete": {
          "type": "boolean"
        },
        "legacy_usage_assessed": {
          "type": "boolean"
        },
        "owner_approved": {
          "type": "boolean"
        }
      }
    },
    "privacy_notice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "current_stage": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
      "maxLength": 64
    },
    "projectFact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "cloudbaseGatewayUrl": {
      "type": "string",
      "pattern": "^https://[^/?#]+\\.app\\.tcloudbase\\.com(?::443)?/?$",
      "maxLength": 2048
    },
    "updateTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "installation_type", "channel"],
      "properties": {
        "os": { "enum": ["windows", "macos", "ubuntu", "debian"] },
        "architecture": { "enum": ["x86", "x86_64", "arm64"] },
        "installation_type": { "enum": ["installed", "portable"] },
        "channel": { "enum": ["stable", "beta"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "os": { "enum": ["macos", "ubuntu", "debian"] } },
            "required": ["os"]
          },
          "then": {
            "properties": { "architecture": { "enum": ["x86_64", "arm64"] } }
          }
        }
      ]
    },
    "releaseStream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architecture", "channel", "code"],
      "properties": {
        "platform": {
          "enum": ["windows", "macos", "linux"]
        },
        "architecture": {
          "enum": ["x64", "arm64", "ia32"]
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,48}[a-z0-9])?$"
        }
      }
    }
  }
}
